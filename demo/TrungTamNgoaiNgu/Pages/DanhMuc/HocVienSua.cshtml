@page
@model TrungTamNgoaiNgu.Pages.DanhMuc.HocVienSuaModel
@{
    ViewData["Ma"] = "F1.1";
    ViewData["TroGiup"] = "Trường có * là bắt buộc. Trình độ và ngày kiểm tra nhập cùng nhau; phải có trình độ đầu vào trước khi đăng ký học (2.2). Học viên dưới 18 tuổi cần ít nhất một phụ huynh. Hồ sơ không xóa, chỉ chuyển trạng thái Ngừng.";
}
@if (Model.DaLuu)
{
    <div class="hop-tb">Đã lưu hồ sơ @Model.Ma.</div>
}
<form method="post">
    <div asp-validation-summary="All" class="hop-loi"></div>
    <fieldset disabled="@(!Model.ChoSua)">
        <div class="row g-2">
            <div class="col-sm-3"><label class="form-label">Mã HV</label><input class="form-control" value="@(Model.Ma ?? "(hệ thống cấp)")" disabled /></div>
            <div class="col-sm-5"><label asp-for="F.HoTen" class="form-label bat-buoc"></label><input asp-for="F.HoTen" class="form-control" /></div>
            <div class="col-sm-2"><label asp-for="F.NgaySinh" class="form-label bat-buoc"></label><input asp-for="F.NgaySinh" type="date" class="form-control" /></div>
            <div class="col-sm-2">
                <label asp-for="F.GioiTinh" class="form-label bat-buoc"></label>
                <select asp-for="F.GioiTinh" class="form-select"><option>Nam</option><option>Nữ</option></select>
            </div>
            <div class="col-sm-3"><label asp-for="F.DienThoai" class="form-label bat-buoc"></label><input asp-for="F.DienThoai" class="form-control" inputmode="numeric" /></div>
            <div class="col-sm-4"><label asp-for="F.Email" class="form-label"></label><input asp-for="F.Email" class="form-control" /></div>
            <div class="col-sm-5"><label asp-for="F.DiaChi" class="form-label"></label><input asp-for="F.DiaChi" class="form-control" /></div>
            <div class="col-sm-3">
                <label asp-for="F.TrinhDoDauVao" class="form-label"></label>
                <select asp-for="F.TrinhDoDauVao" class="form-select" asp-items="@(new SelectList(TrungTamNgoaiNgu.Pages.DanhMuc.HocVienSuaModel.TrinhDo))"><option value="">(chưa kiểm tra)</option></select>
            </div>
            <div class="col-sm-3"><label asp-for="F.NgayKiemTra" class="form-label"></label><input asp-for="F.NgayKiemTra" type="date" class="form-control" /></div>
            <div class="col-sm-3">
                <label asp-for="F.TrangThai" class="form-label"></label>
                <select asp-for="F.TrangThai" class="form-select"><option>Hoạt động</option><option>Ngừng</option></select>
            </div>
        </div>

        <h2 class="h6 mt-4 fw-bold">Phụ huynh / người giám hộ</h2>
        @if (Model.PhuHuynh.Count > 0)
        {
            <table class="table table-sm table-bordered">
                <thead><tr><th>Mã PH</th><th>Họ tên</th><th>Điện thoại</th><th>Quan hệ</th></tr></thead>
                <tbody>
                    @foreach (var p in Model.PhuHuynh)
                    {
                        <tr><td>@p.MaPH</td><td>@p.MaPHNavigation.HoTen</td><td>@p.MaPHNavigation.DienThoai</td><td>@p.QuanHe</td></tr>
                    }
                </tbody>
            </table>
        }
        @if (Model.ChoSua)
        {
            <div class="row g-2">
                <div class="col-sm-4"><label asp-for="F.PhHoTen" class="form-label"></label><input asp-for="F.PhHoTen" class="form-control" /></div>
                <div class="col-sm-3"><label asp-for="F.PhDienThoai" class="form-label"></label><input asp-for="F.PhDienThoai" class="form-control" inputmode="numeric" /></div>
                <div class="col-sm-3"><label asp-for="F.PhEmail" class="form-label"></label><input asp-for="F.PhEmail" class="form-control" /></div>
                <div class="col-sm-2">
                    <label asp-for="F.QuanHe" class="form-label"></label>
                    <select asp-for="F.QuanHe" class="form-select" asp-items="@(new SelectList(TrungTamNgoaiNgu.Pages.DanhMuc.HocVienSuaModel.QuanHeCo))"><option value="">–</option></select>
                </div>
            </div>
            <p class="small mt-1">Điện thoại phụ huynh đã có trong hệ thống thì dùng lại hồ sơ phụ huynh đó (một phụ huynh có thể có nhiều con).</p>
        }
    </fieldset>
    <div class="mt-3">
        @if (Model.ChoSua)
        {
            <button class="btn btn-primary">Lưu</button>
        }
        <a class="btn btn-outline-primary" href="/DanhMuc/HocVien">Thoát</a>
    </div>
</form>
