@page
@model TrungTamNgoaiNgu.Pages.LopHoc.XepLichModel
@using TrungTamNgoaiNgu.Nen
@{
    ViewData["Ma"] = "F2.3";
    ViewData["TroGiup"] = "Hai buổi trùng khi trùng giờ và cùng giáo viên hoặc cùng phòng (QT07); buổi trùng không được ghi. Để trống Số buổi để thêm buổi học bù; chọn một buổi chưa dạy để đổi ngày, giờ, phòng hoặc giáo viên dạy thay.";
    var c = Model.Chon;
    var duocGhi = User.Co("2.3", "T");
}
<form method="get" class="thanh-loc">
    <div>
        <label class="form-label" for="lop">Lớp</label>
        <select id="lop" name="lop" class="form-select">
            @foreach (var l in Model.CacLop)
            {
                <option value="@l.MaLop" selected="@(l.MaLop == Model.Lop)">@l.MaLop – @l.MaKHNavigation.TenKH (@l.TrangThai)</option>
            }
        </select>
    </div>
    <button class="btn btn-primary">Chọn</button>
</form>
@if (c != null)
{
    <div class="hop-tb">
        <b>@c.MaLop</b> – @c.MaKHNavigation.TenKH · GV @c.MaGV · khai giảng @HienThi.Ngay(c.NgayKhaiGiang) ·
        @c.MaKHNavigation.SoBuoi buổi × @c.MaKHNavigation.ThoiLuongBuoi phút · lịch tuần: @HienThi.Lich(c.LichTuan)
    </div>
    @if (Model.ThongBao != null) { <div class="hop-tb">@Model.ThongBao</div> }
    <div asp-validation-summary="All" class="hop-loi"></div>
    @if (Model.CacBuoi.Count == 0 && duocGhi)
    {
        <form method="post" asp-page-handler="Sinh" class="mb-3">
            <input type="hidden" name="lop" value="@c.MaLop" />
            <button class="btn btn-primary">Sinh lịch theo lịch tuần</button>
        </form>
    }
    @if (duocGhi)
    {
        <form method="post" asp-page-handler="LuuBuoi" class="row g-2 align-items-end mb-3">
            <input type="hidden" name="lop" value="@c.MaLop" />
            <div class="col-6 col-md-1"><label class="form-label" for="SoBuoi">Số buổi</label>
                <input id="SoBuoi" name="SoBuoi" class="form-control" value="@Model.SoBuoi" placeholder="bù" type="number" min="1" step="1" title="Số thứ tự buổi cần đổi; bỏ trống để thêm buổi học bù" /></div>
            <div class="col-6 col-md-2"><label class="form-label bat-buoc" for="Ngay">Ngày</label>
                <input id="Ngay" name="Ngay" type="date" class="form-control" value="@Model.Ngay?.ToString("yyyy-MM-dd")" /></div>
            <div class="col-6 col-md-1"><label class="form-label bat-buoc" for="GioBatDau">Từ</label>
                <input id="GioBatDau" name="GioBatDau" type="time" class="form-control" value="@Model.GioBatDau?.ToString("HH:mm")" /></div>
            <div class="col-6 col-md-1"><label class="form-label bat-buoc" for="GioKetThuc">Đến</label>
                <input id="GioKetThuc" name="GioKetThuc" type="time" class="form-control" value="@Model.GioKetThuc?.ToString("HH:mm")" /></div>
            <div class="col-6 col-md-1"><label class="form-label bat-buoc" for="MaPhong">Phòng</label>
                <select id="MaPhong" name="MaPhong" class="form-select">
                    @foreach (var p in Model.CacPhong) { <option selected="@(p == Model.MaPhong)">@p</option> }
                </select></div>
            <div class="col-6 col-md-2"><label class="form-label bat-buoc" for="MaGV">Giáo viên</label>
                <select id="MaGV" name="MaGV" class="form-select">
                    @foreach (var g in Model.CacGV) { <option value="@g.MaGV" selected="@(g.MaGV == (Model.MaGV ?? c.MaGV))">@g.MaGV – @g.HoTen</option> }
                </select></div>
            <div class="col-12 col-md-2"><label class="form-label" for="NoiDung">Nội dung</label>
                <input id="NoiDung" name="NoiDung" class="form-control" value="@Model.NoiDung" maxlength="200" /></div>
            <div class="col-12"><partial name="_NutLenh" model="new NutLenh()" /></div>
        </form>
    }
    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle">
            <thead><tr><th>Buổi</th><th>Ngày</th><th>Giờ</th><th>Phòng</th><th>Giáo viên</th><th>Loại</th><th>Nội dung</th><th>Trạng thái</th></tr></thead>
            <tbody>
                @foreach (var b in Model.CacBuoi)
                {
                    <tr class="@(b.TrangThai == "Hủy" ? "table-secondary" : "")">
                        <td>@b.SoBuoi</td><td>@HienThi.Thu((byte)(b.Ngay.DayOfWeek == DayOfWeek.Sunday ? 8 : (int)b.Ngay.DayOfWeek + 1)) @HienThi.Ngay(b.Ngay)</td>
                        <td>@b.GioBatDau.ToString("HH:mm")–@b.GioKetThuc.ToString("HH:mm")</td><td>@b.MaPhong</td>
                        <td>@b.MaGV@(b.MaGV != c.MaGV ? " (dạy thay)" : "")</td><td>@b.Loai</td><td>@b.NoiDung</td><td>@b.TrangThai</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
