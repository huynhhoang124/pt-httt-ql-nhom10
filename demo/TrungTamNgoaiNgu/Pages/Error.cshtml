@page
@model ErrorModel
@{
    ViewData["Title"] = Model.Ma == 404 ? "Không tìm thấy trang" : "Có lỗi xảy ra";
}
<div class="hop-loi">
    @if (Model.Ma == 404)
    {
        <span>Địa chỉ này không có trong hệ thống. Gợi ý: kiểm tra lại địa chỉ, hoặc chọn chức năng trên <a href="/">thực đơn chính</a>.</span>
    }
    else
    {
        <span>Hệ thống chưa xử lý được yêu cầu này; dữ liệu đang nhập chưa được lưu. Gợi ý: quay lại và thử lần nữa; nếu vẫn lỗi, báo quản trị viên kèm mã lỗi bên dưới.</span>
    }
</div>
<p class="small">Mã lỗi: <code>@Model.RequestId</code></p>
<a class="btn btn-outline-primary" href="/">Về thực đơn chính</a>
