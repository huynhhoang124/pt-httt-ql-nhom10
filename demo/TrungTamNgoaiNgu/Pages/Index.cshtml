@page
@using TrungTamNgoaiNgu.Nen
@{
    ViewData["Title"] = "Trang chủ";
    // Thực đơn phân cấp (06_giao_dien mục 5.1): phân hệ → module → màn hình, trình bày như mục lục
    var thucDon = ThucDon.ChoVaiTro(User.VaiTro());
}
<p class="dan-nhap">Chọn chức năng cần làm. Mỗi tài khoản chỉ thấy các chức năng được phép.</p>
<div class="muc-luc">
    @foreach (var ph in thucDon)
    {
        <section class="muc-luc-nhom" aria-labelledby="ph-@ph.Ma.Replace(".", "")">
            <h2 id="ph-@ph.Ma.Replace(".", "")">@ph.Ten</h2>
            @foreach (var m in ph.Module)
            {
                <div class="muc-luc-module">@m.Ma @m.Ten</div>
                <ul>
                    @foreach (var d in m.ManHinh)
                    {
                        <li><a href="@d.Url"><span class="ma">@d.Ma</span><span>@d.Ten</span></a></li>
                    }
                </ul>
            }
        </section>
    }
</div>
