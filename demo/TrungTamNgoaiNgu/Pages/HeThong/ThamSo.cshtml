@page
@model TrungTamNgoaiNgu.Pages.HeThong.ThamSoModel
@{
    ViewData["Ma"] = "F5.1b";
    ViewData["TroGiup"] = "Đổi con số chính sách (sĩ số, tỷ lệ giảm, ngưỡng điểm…) mà không sửa chương trình. Mỗi thay đổi được ghi nhật ký.";
}
@if (Model.ThongBao != null) { <div class="hop-tb">@Model.ThongBao</div> }
<form method="post">
    <div asp-validation-summary="All" class="hop-loi"></div>
    <div class="table-responsive">
        <table class="table table-sm table-bordered align-middle">
            <thead><tr><th>Quy tắc</th><th>Tham số</th><th style="width:8rem">Giá trị</th><th>Đơn vị</th></tr></thead>
            <tbody>
                @foreach (var t in Model.DanhSach)
                {
                    <tr>
                        <td>@t.QuyTac</td><td>@t.TenThamSo <span class="small text-secondary">(@t.MaThamSo)</span></td>
                        <td><input name="GiaTri[@t.MaThamSo]" value="@t.GiaTri.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" class="form-control form-control-sm so" inputmode="decimal" /></td>
                        <td>@t.DonVi</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <partial name="_NutLenh" model="new NutLenh()" />
</form>
