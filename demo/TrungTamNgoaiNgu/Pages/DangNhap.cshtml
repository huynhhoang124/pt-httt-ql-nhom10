@page
@model DangNhapModel
@{
    ViewData["Ma"] = "FN1";
    ViewData["Title"] = "FN1 Đăng nhập";
    ViewData["TroGiup"] = "Tài khoản do quản trị viên cấp. Nhập sai 5 lần liên tiếp thì tài khoản bị khóa tạm 15 phút.";
}
<form method="post" class="col-sm-8 col-md-5">
    <div asp-validation-summary="All" class="hop-loi"></div>
    <div class="mb-2">
        <label asp-for="TenDangNhap" class="form-label bat-buoc"></label>
        <input asp-for="TenDangNhap" class="form-control" autofocus autocomplete="username" />
    </div>
    <div class="mb-3">
        <label asp-for="MatKhau" class="form-label bat-buoc"></label>
        <input asp-for="MatKhau" class="form-control" autocomplete="current-password" />
    </div>
    <button class="btn btn-primary">Đăng nhập</button>
</form>
