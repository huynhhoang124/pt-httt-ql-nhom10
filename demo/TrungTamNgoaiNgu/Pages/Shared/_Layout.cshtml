@using TrungTamNgoaiNgu.Nen
@inject DongHo DongHo
@{
    // Bố cục chung (06_giao_dien mục 5.2): đường dẫn "phân hệ › module" · tên màn hình · ô "Mẫu" ghi mã form/báo cáo
    // (như ô "Mẫu số" trên chứng từ giấy) · nội dung · nút lệnh ở cuối form · dòng trợ giúp ở đáy.
    var maTrang = (ViewData["Ma"] as string)?.Split(", ") ?? [];
    string? duongDan = null, ten = ViewData["Title"] as string;
    if (maTrang.Length > 0)
    {
        var mod = ThucDon.Module.First(m => m.Ma == ThucDon.ManHinh[maTrang[0]].Module);
        duongDan = $"{ThucDon.TenPhanHe(mod.PhanHe)} › {mod.Ma} {mod.Ten}";
        ten = ten is null ? string.Join(" · ", maTrang.Select(m => ThucDon.ManHinh[m].Ten))
            : ten.StartsWith(maTrang[0] + " ") ? ten[(maTrang[0].Length + 1)..] : ten;
    }
    var daDangNhap = User.Identity?.IsAuthenticated == true;
    var coThucDon = daDangNhap && Context.Request.Path != "/" && !Context.Request.Path.StartsWithSegments("/DangNhap");
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(maTrang.Length > 0 ? string.Join(", ", maTrang) + " " : "")@(ten ?? "Trang chủ") – Trung tâm ngoại ngữ</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    @* Phông tải không chặn hiển thị: máy không có Internet vẫn mở trang ngay, dùng Segoe UI thay *@
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Literata:opsz,wght@7..72,600&display=swap" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="bo-qua" href="#noi-dung">Bỏ qua danh sách chức năng, tới nội dung</a>
    <header class="thanh-tren d-print-none">
        <a class="ten-he-thong" href="/">Trung tâm ngoại ngữ <span class="phu d-none d-sm-inline">Hệ thống quản lý</span></a>
        @if (daDangNhap)
        {
            <div class="nguoi-dung">
                <span><b>@User.Identity!.Name</b> <span class="vai-tro">@ThucDon.TenVaiTro(User.VaiTro())</span></span>
                <form method="post" asp-page="/DangXuat" data-dang-xuat="@User.Identity.Name">
                    <button class="btn btn-sm btn-outline-primary">Đăng xuất</button>
                </form>
            </div>
        }
    </header>
    <div class="khung @(coThucDon ? "co-thuc-don" : "")">
        @if (coThucDon)
        {
            <aside class="cot-trai d-print-none"><partial name="_ThucDon" /></aside>
        }
        <main id="noi-dung" tabindex="-1">
            @if (coThucDon)
            {
                <details class="thuc-don-gon d-print-none">
                    <summary>Chức năng</summary>
                    <partial name="_ThucDon" />
                </details>
            }
            @if (ten != null)
            {
                @* Dải đầu trang kẻ ô li, có đường lề như trang đầu cuốn vở (thiet_ke/de_xuat_giao_dien_v2.md) *@
                <div class="dau-trang">
                    @if (duongDan != null)
                    {
                        <div class="duong-dan d-print-none">@duongDan</div>
                    }
                    <div class="hang-tieu-de">
                        <h1 class="tieu-de">@ten</h1>
                        @if (maTrang.Length > 0)
                        {
                            <div class="o-mau" title="Mã màn hình trong thiết kế (06_giao_dien)">
                                <span>Mẫu</span>
                                @foreach (var m in maTrang) { <b>@m</b> }
                            </div>
                        }
                        @if (ViewData["TroGiup"] is string goiY)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary nut-tro-giup d-print-none" data-tro-giup title="Trợ giúp (F1): @goiY" aria-label="Trợ giúp (F1)">?</button>
                        }
                    </div>
                </div>
            }
            <div class="than-trang">@RenderBody()</div>
        </main>
    </div>
    <footer class="tro-giup d-print-none">
        @if (ViewData["TroGiup"] is string tg)
        {
            <p id="tro-giup" tabindex="-1"><b>Trợ giúp.</b> @tg</p>
        }
        <p class="gio">Giờ hệ thống: @DongHo.Bay.ToString("dd/MM/yyyy HH:mm")</p>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
