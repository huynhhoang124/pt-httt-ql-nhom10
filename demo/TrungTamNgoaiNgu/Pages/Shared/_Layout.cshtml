@using TrungTamNgoaiNgu.Nen
@inject DongHo DongHo
@{
    // Mã màn hình (06_giao_dien) → tiêu đề và đường dẫn "phân hệ › module › màn hình" (quy ước bố cục 06_giao_dien mục 5.2)
    var ma = ViewData["Ma"] as string;
    string? tieuDe = ViewData["Title"] as string, duongDan = null;
    if (ma != null)
    {
        var mh = ma.Split(", ").Select(ThucDon.Ten);
        tieuDe ??= string.Join(" · ", mh);
        var mod = ThucDon.Module.First(m => m.Ma == ThucDon.ManHinh[ma.Split(", ")[0]].Module);
        duongDan = $"{ThucDon.TenPhanHe(mod.PhanHe)} › {mod.Ma} {mod.Ten}";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(tieuDe ?? "Trang chủ") – Trung tâm ngoại ngữ</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="thanh-tren d-print-none">
        <div class="container-lg d-flex flex-wrap align-items-center gap-2 py-2">
            <a class="ten-he-thong me-auto" href="/"><span class="d-none d-sm-inline">Trung tâm ngoại ngữ – </span>Hệ thống quản lý</a>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="d-flex align-items-center gap-2 text-nowrap">
                    <span class="small">@User.Identity.Name · @User.VaiTro()</span>
                    <form method="post" asp-page="/DangXuat" class="d-inline" data-dang-xuat="@User.Identity.Name">
                        <button class="btn btn-sm btn-outline-light">Đăng xuất</button>
                    </form>
                </div>
            }
        </div>
    </header>
    <main class="container-lg py-3">
        @if (duongDan != null)
        {
            <div class="duong-dan d-print-none">@duongDan</div>
        }
        @if (tieuDe != null)
        {
            <div class="d-flex align-items-start gap-2">
                <h1 class="tieu-de me-auto">@tieuDe</h1>
                @if (ViewData["TroGiup"] is string goiY)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary nut-tro-giup d-print-none" data-tro-giup title="Trợ giúp (F1): @goiY" aria-label="Trợ giúp (F1)">?</button>
                }
            </div>
        }
        @RenderBody()
    </main>
    <footer class="tro-giup d-print-none">
        <div class="container-lg py-2 small">
            @if (ViewData["TroGiup"] is string tg)
            {
                <span id="tro-giup" tabindex="-1"><b>Trợ giúp:</b> @tg</span>
                <span class="mx-2">·</span>
            }
            <span>Giờ hệ thống: @DongHo.Bay.ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
