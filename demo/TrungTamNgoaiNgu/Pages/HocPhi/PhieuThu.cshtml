@page
@model TrungTamNgoaiNgu.Pages.HocPhi.PhieuThuModel
@using TrungTamNgoaiNgu.Nen
@inject DongHo DongHo
@{
    ViewData["Ma"] = "F3.2";
    ViewData["TongPhieu"] = ("Tổng tiền phiếu", "0 đ");   // site.js cộng lại khi nhập (ô có data-tong)
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    ViewData["TroGiup"] = "Đợt 1 tối thiểu 50% số phải nộp (QT05); không nộp vượt số còn nợ của đợt. Bỏ trống ô các đợt không nộp. Số phiếu, ngày thu, người thu do hệ thống điền; phiếu đã lập không sửa, thu sai thì lập phiếu điều chỉnh.";
    var h = Model.HocVien;
}
<form method="get" class="thanh-loc">
    <label class="form-label bat-buoc mt-2" for="hv">Học viên (mã HV)</label>
    <input id="hv" name="hv" list="ds-hoc-vien" autocomplete="off" value="@Model.Hv" class="form-control" style="max-width:12rem" placeholder="vd HV0412" pattern="[Hh][Vv][0-9]{4}" title="Mã học viên, vd HV0412; gõ tên để được gợi ý" />
    <button class="btn btn-primary">Chọn</button>
</form>
@if (Model.Hv != null && h == null)
{
    <div class="hop-loi">Không có học viên mã @Model.Hv.</div>
}
@if (h != null)
{
    <div class="hop-tb"><b>@h.MaHV – @h.HoTen</b> · ĐT @h.DienThoai @if (Model.PhuHuynh.Count > 0) { <span>· phụ huynh: @string.Join(", ", Model.PhuHuynh)</span> }</div>
    @if (Model.DanhSach.Count == 0)
    {
        <p>Học viên không còn khoản học phí nào chưa đóng.</p>
    }
    else
    {
        <form method="post" data-xac-nhan="Phiếu đã lập không sửa được; thu sai thì lập phiếu điều chỉnh." data-xac-nhan-tieu-de="Lập phiếu thu?" data-xac-nhan-nut="Lập phiếu">
            <input type="hidden" name="hv" value="@h.MaHV" />
            <div asp-validation-summary="All" class="hop-loi"></div>
            <div class="row g-2 mb-2">
                <div class="col-sm-5"><label class="form-label bat-buoc" for="NguoiNop">Người nộp</label><input asp-for="NguoiNop" class="form-control" /></div>
                <div class="col-sm-5">
                    <span class="form-label bat-buoc d-block">Hình thức</span>
                    <div class="chon-doan" role="radiogroup" aria-label="Hình thức">
                        @foreach (var (ht, i) in new[] { "Tiền mặt", "Chuyển khoản" }.Select((h, i) => (h, i)))
                        {
                            <input type="radio" id="ht-@i" name="HinhThuc" value="@ht" checked="@(Model.HinhThuc == ht)" />
                            <label for="ht-@i"><svg class="ic ic-nho"><use href="#@(i == 0 ? "banknote" : "credit-card")" /></svg>@ht</label>
                        }
                    </div>
                </div>
            </div>
            <h2 class="h6 fw-bold">Các đợt còn nợ</h2>
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle">
                    <thead><tr><th>Lớp</th><th>Khóa học</th><th>Đợt</th><th>Hạn đóng</th><th class="so">Phải nộp đợt</th><th class="so">Đã nộp</th><th class="so">Còn nợ</th><th style="width:15rem">Nộp lần này</th></tr></thead>
                    <tbody>
                        @for (int i = 0; i < Model.DanhSach.Count; i++)
                        {
                            var d = Model.DanhSach[i];
                            var quaHan = d.Han < DongHo.HomNay;
                            var conNo = d.ConNoDot.ToString("0", inv);
                            <tr>
                                <td>@d.MaLopHienTai @if (d.MaLopHienTai != d.MaLop) { <span class="small">(khoản của @d.MaLop)</span> }</td>
                                <td>@d.TenKH</td><td>@d.SoDot</td>
                                <td>@HienThi.Ngay(d.Han)@if (quaHan) { <span class="nhan nhan-nguy-hiem ms-1">Quá hạn</span> }</td>
                                <td class="so">@HienThi.So(d.SoTienDot)</td><td class="so">@HienThi.So(d.DaThuDot)</td><td class="so">@HienThi.So(d.ConNoDot)</td>
                                <td>
                                    <div class="d-flex gap-1 align-items-center">
                                        <input type="number" name="SoTien[@i]" value="@(i < Model.SoTien.Count ? Model.SoTien[i]?.ToString("0", inv) : null)" min="0" max="@conNo" step="1000" inputmode="numeric"
                                               class="form-control form-control-sm so" data-tong data-doc-tien aria-label="Nộp lần này, lớp @d.MaLop đợt @d.SoDot"
                                               title="Số tiền (đồng), bội số 1.000, không quá số còn nợ; bỏ trống nếu không nộp đợt này" />
                                        <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" data-nop-du="@conNo" title="Điền đủ số còn nợ của đợt: @HienThi.Tien(d.ConNoDot)">Nộp đủ</button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <partial name="_NutLenh" model='new NutLenh("Lập phiếu thu", Nhap:$"F3.2:{h.MaHV}:{string.Join(",", Model.DanhSach.Select(d => $"{d.MaLop}-{d.SoDot}"))}")' />
        </form>
    }
}
<partial name="_GoiYHocVien" />
