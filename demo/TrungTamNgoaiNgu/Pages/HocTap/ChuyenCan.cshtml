@page
@model TrungTamNgoaiNgu.Pages.HocTap.ChuyenCanModel
@using TrungTamNgoaiNgu.Nen
@using TrungTamNgoaiNgu.NghiepVu
@{
    ViewData["Ma"] = "R4.1";
    ViewData["TroGiup"] = "Theo dõi tỷ lệ chuyên cần và chi tiết điểm danh từng buổi theo lớp. Học viên vắng quá ngưỡng cảnh báo (QT12) được hiển thị dòng cảnh báo màu đỏ.";
}

@if (Model.CoQuyenNhapHV)
{
    <form method="get" class="thanh-loc">
        <div>
            <label class="form-label" for="mahv">Mã học viên</label>
            <input id="mahv" name="mahv" value="@Model.MaHV" class="form-control" list="ds-hoc-vien" placeholder="vd: HV0480" required />
        </div>
        <button class="btn btn-primary">Xem chuyên cần</button>
    </form>
    <partial name="_GoiYHocVien" />
}
else if (Model.CacHocVienDuocXem.Count > 1)
{
    <form method="get" class="thanh-loc">
        <div>
            <label class="form-label" for="mahv">Học viên</label>
            <select id="mahv" name="mahv" class="form-select" onchange="this.form.submit()">
                @foreach (var h in Model.CacHocVienDuocXem)
                {
                    <option value="@h.MaHV" selected="@(h.MaHV == Model.MaHV)">@h.MaHV – @h.HoTen</option>
                }
            </select>
        </div>
        <button class="btn btn-primary">Chọn</button>
    </form>
}

<div asp-validation-summary="All" class="hop-loi"></div>

@if (Model.HocVienChon == null)
{
    @if (Model.CoQuyenNhapHV)
    {
        <div class="hop-tb">Nhập mã học viên hoặc chọn từ danh sách gợi ý để xem tình hình chuyên cần.</div>
    }
}
else
{
    <div class="hop-tb mb-3">
        <b>Học viên:</b> @Model.HocVienChon.MaHV – @Model.HocVienChon.HoTen
        <span class="ms-2">· Ngày sinh: @HienThi.Ngay(Model.HocVienChon.NgaySinh)</span>
        @if (!string.IsNullOrEmpty(Model.HocVienChon.DienThoai)) { <span class="ms-2">· ĐT: @Model.HocVienChon.DienThoai</span> }
    </div>

    <h2 class="h5 fw-bold mb-2">Tình hình chuyên cần theo lớp</h2>
    @if (Model.DanhSachLop.Count == 0)
    {
        <p class="text-secondary">Học viên chưa đăng ký lớp học nào.</p>
    }
    else
    {
        <div class="table-responsive mb-4">
            <table class="table table-bordered table-sm align-middle">
                <thead>
                    <tr>
                        <th>Mã lớp</th>
                        <th>Khóa học</th>
                        <th>Trạng thái lớp</th>
                        <th class="so">Buổi đã học</th>
                        <th class="so">Có mặt</th>
                        <th class="so">Đi muộn</th>
                        <th class="so">Vắng có phép</th>
                        <th class="so">Vắng không phép</th>
                        <th class="so">Tỷ lệ chuyên cần</th>
                        <th>Tình trạng</th>
                        <th>Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in Model.DanhSachLop)
                    {
                        var isChon = d.Lop.MaLop == Model.Lop;
                        <tr class="@(isChon ? "table-active" : "")">
                            <td><b>@d.Lop.MaLop</b></td>
                            <td>@d.Lop.MaKHNavigation.TenKH</td>
                            <td>@d.Lop.TrangThai</td>
                            <td class="so">@d.SoBuoiDaHoc/@d.Lop.MaKHNavigation.SoBuoi</td>
                            <td class="so">@d.SoCoMat</td>
                            <td class="so">@d.SoDiMuon</td>
                            <td class="so">@d.SoVangCoPhep</td>
                            <td class="so @(d.SoVangKhongPhep > 0 ? "canh-bao" : "")">@d.SoVangKhongPhep</td>
                            <td class="so"><b>@(d.TyLeChuyenCan != null ? $"{d.TyLeChuyenCan:0.0}%" : "–")</b></td>
                            <td>
                                @if (d.CanhBaoVang)
                                {
                                    <span class="canh-bao">Vắng &gt; @Model.NguongCanhBaoVang% (QT12)</span>
                                }
                                else if (d.NguyCoKhongDat)
                                {
                                    <span class="canh-bao">Nguy cơ không đạt</span>
                                }
                                else
                                {
                                    <span>Bình thường</span>
                                }
                            </td>
                            <td>
                                <a asp-page="/HocTap/ChuyenCan" asp-route-mahv="@Model.MaHV" asp-route-lop="@d.Lop.MaLop"
                                   class="btn btn-sm @(isChon ? "btn-primary" : "btn-outline-primary")">
                                    @(isChon ? "Đang xem" : "Xem buổi")
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (Model.LopChon != null && Model.ThongKeLopChon != null)
    {
        var tk = Model.ThongKeLopChon;
        <div class="hop-tb mt-4 mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div>
                    <h3 class="h5 fw-bold mb-1">Chi tiết điểm danh: @Model.LopChon.MaLop – @Model.LopChon.MaKHNavigation.TenKH</h3>
                    <div class="small">
                        Giáo viên: @Model.LopChon.MaGVNavigation.HoTen · Khai giảng: @HienThi.Ngay(Model.LopChon.NgayKhaiGiang) · Tổng số: @Model.LopChon.MaKHNavigation.SoBuoi buổi
                    </div>
                </div>
                <div class="text-end">
                    <div>Tỷ lệ chuyên cần: <b>@(tk.TyLeChuyenCan != null ? $"{tk.TyLeChuyenCan:0.0}%" : "–")</b> (Có mặt @(tk.SoCoMat + tk.SoDiMuon)/@tk.SoBuoiDaHoc buổi đã dạy)</div>
                </div>
            </div>
            @if (tk.CanhBaoVang)
            {
                <div class="canh-bao mt-2">
                    @QuyTac.CanhBaoVang(Model.HocVienChon.HoTen, Model.LopChon.MaLop, Model.NguongCanhBaoVang, tk.NguyCoKhongDat, Model.NguongChuyenCanDat)
                </div>
            }
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-sm align-middle">
                <thead>
                    <tr>
                        <th>Buổi</th>
                        <th>Ngày học</th>
                        <th>Giờ học</th>
                        <th>Phòng</th>
                        <th>Loại buổi</th>
                        <th>Trạng thái buổi</th>
                        <th>Điểm danh</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model.DanhSachBuoi)
                    {
                        <tr>
                            <td>Buổi @b.SoBuoi</td>
                            <td>@HienThi.Ngay(b.Ngay)</td>
                            <td>@b.GioBatDau.ToString("HH\\:mm")–@b.GioKetThuc.ToString("HH\\:mm")</td>
                            <td>@b.MaPhong</td>
                            <td>@b.Loai</td>
                            <td>@b.TrangThaiBuoi</td>
                            <td>
                                @if (b.TrangThaiDiemDanh == "x")
                                {
                                    <span>Có mặt</span>
                                }
                                else if (b.TrangThaiDiemDanh == "M")
                                {
                                    <span>Đi muộn</span>
                                }
                                else if (b.TrangThaiDiemDanh == "P")
                                {
                                    <span>Vắng có phép</span>
                                }
                                else if (b.TrangThaiDiemDanh == "K")
                                {
                                    <span class="canh-bao">Vắng không phép</span>
                                }
                                else
                                {
                                    <span class="text-secondary">@b.TenTrangThai</span>
                                }
                            </td>
                            <td>@(string.IsNullOrWhiteSpace(b.GhiChu) ? (b.NoiDung ?? "–") : b.GhiChu)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <div class="mt-3">
        <partial name="_NutLenh" model="new NutLenh(null)" />
    </div>
}
